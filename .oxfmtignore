# oxfmt ignore — files oxfmt must NOT touch.
#
# Release-please owns changelog and manifest bytes; the general repository
# formatter must not rewrite them between release PR updates. Its JSON
# extra-file updater rewrites the whole of `.github/scaffold.json` (an inline
# array comes back expanded), so oxfmt must leave that file to it as well.
changelog/
.release-please-manifest.json
release-please-config.json
.github/scaffold.json

# Frozen/hash-addressed upstream-sync provenance. These bytes are reviewed and
# verified by SHA rather than rewritten by the general Markdown formatter.
docs/upstream-sync/UPSTREAM.md
docs/upstream-sync/V1_5_COMMIT_MANIFEST.md

# The selected viewer design, transcribed from the Penpot boards: its tables
# are numeric specs read against the board exports, so their layout is frozen.
docs/design/viewer-d.md

# Golden artifacts are byte-compared by the equivalence/golden oracle tests
# (include_str! / fs::read). Reformatting them breaks the test suite.
reference/

# Test input fixtures are parsed by the extractors; reformatting changes the
# extraction output and breaks golden parity. The tier2 fixtures additionally
# assert on exact LINE NUMBERS (a self-edge is only distinguishable from a
# correct edge by start_line), so reflowing them breaks those assertions.
crates/codegraph-bench/fixtures/
crates/codegraph-extract/tests/fixtures/
crates/codegraph-resolve/tests/fixtures/

# Embedded verbatim into the MCP tools/list response and byte-compared against
# golden; reformatting breaks the MCP golden test.
crates/codegraph-mcp/src/tools_list.json

# Parsed at runtime by the golden oracle (KnownDiffs::load reads `RULE tier=…`
# lines); reformatting can break that line-oriented parse.
KNOWN_DIFFS.md

# TOML manifests are owned by `cargo fmt` conventions, not oxfmt.
*.toml

# Rust sources are formatted by `cargo fmt`.
*.rs

# The browser viewer is vendored from upstream colbymchenry/codegraph (ui/,
# MIT, see ui/LICENSE) and keeps upstream's formatting so it stays diffable
# against the release it was imported from; svelte-check and the UI tests are
# its gate. Its committed build output is generated, not authored.
ui/
crates/codegraph-ui/viewer/

# Build artifacts / vendored deps.
target/
dist/
node_modules/

# IDE local configuration (editor paths/settings, not versioned).
.zed/
