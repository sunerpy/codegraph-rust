      "startLine": 3,
      "endLine": 7,
      "language": "typescript",
      "content": "export function runDemo(): number {\n  const counter = new Counter();\n  counter.increment(add(1, 2));\n  return counter.increment();\n}",
      "nodeName": "runDemo",
      "nodeKind": "function"
    },
    {
