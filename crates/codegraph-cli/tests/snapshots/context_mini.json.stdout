      "startLine": 1,
      "endLine": 3,
      "language": "typescript",
      "content": "export function add(left: number, right: number): number {\n  return left + right;\n}",
      "nodeName": "add",
      "nodeKind": "function"
    },
    {
      "filePath": "src/math.ts",
      "startLine": 5,
      "endLine": 12,
      "language": "typescript",
      "content": "export class Counter {\n  private value = 0;\n\n  increment(step: number = 1): number {\n    this.value = add(this.value, step);\n    return this.value;\n  }\n}",
      "nodeName": "Counter",
      "nodeKind": "class"
    },
